{
  "name": "@axodus/trading-core",
  "version": "0.1.0-phase1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs",
    "val:04b2:r4:public": "npm run build && node ../../../dist/services/trading-core/trading-core/services/trading-core/src/external/val-04b2-live-runner.js --public",
    "val:04b2:r4:execute": "npm run build && node ../../../dist/services/trading-core/trading-core/services/trading-core/src/external/val-04b2-live-runner.js --execute",
    "val:04b2:r4:verify-built": "npm run build && node scripts/verify-val-04b2-built-runner.mjs",
    "val:05:fix01:reconcile": "npm run build && node ../../../dist/services/trading-core/trading-core/services/trading-core/src/external/val-05-fix01-readonly-reconciliation.js",
    "trading-db": "npm run build && node --experimental-strip-types scripts/trading-db.ts",
    "db:bootstrap-local": "npm run build && node --experimental-strip-types scripts/bootstrap-local-db.ts",
    "db:healthcheck": "npm run build && node --experimental-strip-types scripts/healthcheck-db.ts",
    "db:seed-local": "npm run build && node --experimental-strip-types scripts/seed-local-trading.ts",
    "db:smoke-local": "npm run build && node --experimental-strip-types scripts/smoke-local-postgres.ts",
    "db:reset-local": "npm run build && node --experimental-strip-types scripts/reset-local-db.ts",
    "trading:local:e2e": "npm run build && node --experimental-strip-types scripts/trading-local-e2e.ts"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
